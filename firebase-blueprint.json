{
  "entities": {
    "Question": {
      "title": "Question",
      "description": "Represents a single question within a quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "answer": { "type": "string" },
        "marks": { "type": "number" },
        "complexity": { "type": "string" }
      },
      "required": ["id", "type", "question", "answer", "marks"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Represents a generated quiz",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The user ID of the teacher who created the quiz." },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "title": { "type": "string" },
        "examType": { "type": "string" },
        "chapterName": { "type": "string" },
        "totalMarks": { "type": "number" },
        "duration": { "type": "number" },
        "subject": { "type": "string" },
        "classLevel": { "type": "string" },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/entities/Question" }
        }
      },
      "required": ["userId", "title", "questions"]
    }
  },
  "firestore": {
    "quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Quizzes generated by teachers."
    }
  }
}
